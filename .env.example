# Template de variables de entorno para Proyecto Yunta
# Copia este archivo a .env.local y completa con las credenciales de tu proyecto Supabase

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Aviso por email cuando se agota el tóner de una impresora (cron diario,
# ver vercel.json → /api/cron/revisar-toner). Si falta RESEND_API_KEY, el
# aviso sigue apareciendo en la app pero no se manda ningún mail.
RESEND_API_KEY=re_tu_api_key
# Remitente. Con onboarding@resend.dev funciona sin verificar dominio (sirve
# para probar); para usarlo en serio, verificá tu dominio en Resend.
RESEND_FROM=Inventario La Yunta <onboarding@resend.dev>
# Clave que protege la ruta del cron para que no la pueda llamar cualquiera.
# Inventá una cadena larga al azar y cargala igual en Vercel.
CRON_SECRET=una_cadena_larga_al_azar
